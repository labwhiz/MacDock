*.xsd.cs

# OpenCover UI 分析结果
OpenCover/

# Azure Stream Analytics 本地运行输出
ASALocalRun/

# MSBuild 二进制与结构化日志
*.binlog
MSBuild_Logs/

# AWS SAM 生成与临时产物目录
.aws-sam

# NVidia Nsight GPU 调试器配置文件
*.nvuser

# MFractors（Xamarin 生产力工具）工作目录
**/.mfractor/

# Visual Studio 本地历史
**/.localhistory/

# Visual Studio History (VSHistory) 文件
.vshistory/

# BeatPulse 健康检查临时数据库
healthchecksdb

# Visual Studio 2017 中 Package Reference Convert 工具的备份文件夹
MigrationBackup/

# Ionide（跨平台 F# VS Code 工具）工作目录
**/.ionide/

# Fody - 自动生成的 XML schema
FodyWeavers.xsd

# 适用于多工具的 VS Code 文件
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Visual Studio Code 本地历史
.history/

# 已生成的 Visual Studio Code 扩展
*.vsix

# 来自生成输出的 Windows Installer 文件
*.cab
*.msi
*.msix
*.msm
*.msp

# === 项目专属规则 ===
# Claude Code 本地配置
.claude/
# 本地 .NET 工具链缓存目录
.dotnet-home/
# 安装包等构建产物，不入库
installer/*.exe
# 宣传素材：忽略整个 promo/ 目录（上游将 images/ 与 pages/ 合并为 promo/）。
# 注意范围较宽，会一并忽略 promo/ 下所有文件；
# 若日后需跟踪其中源文件（如 HTML 模板、说明文档），应拆回 promo/images/ 与 promo/pages/。
# 此条待与上游开发者确认取舍。
promo/
# 临时内容（脚本 / 素材 / 个人笔记），统一放 temp/ 下，不纳入版本控制
temp/
# === 本地 / 工具元数据（不入库）===
# WorkBuddy 工作区元数据，不入库
.workbuddy/
