# TeamCity 是一款构建插件
_TeamCity*

# DotCover 是一款代码覆盖率工具
*.dotCover

# AxoCover 是一款代码覆盖率工具
.axoCover/*
!.axoCover/settings.json

# Coverlet 是一款免费的跨平台代码覆盖率工具
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio 代码覆盖率结果
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield 输出目录
[Ee]xpress/

# DocProject 是一款文档生成插件
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Click-Once 目录
publish/

# 发布 Web 输出
*.[Pp]ublish.xml
*.azurePubxml
# 注意：若想提交你的 Web 部署设置，请注释掉下一行，
# 但数据库连接字符串（可能含密码）将以明文保存
*.pubxml
*.publishproj

# Microsoft Azure Web App 发布设置。若想提交
# Azure Web App 发布设置，请注释下一行，
# 但这些脚本中的敏感信息将以明文保存
PublishScripts/

# NuGet 包
*.nupkg
# NuGet 符号包
*.snupkg
# packages 文件夹可忽略，因为可通过 Package Restore 还原
**/[Pp]ackages/*
# 但保留 build/，它被用作 MSBuild 目标
!**/[Pp]ackages/build/
# 如有必要可取消注释，通常会在需要时重新生成
#!**/[Pp]ackages/repositories.config
# NuGet v3 的 project.json 文件会生成更多可忽略文件
*.nuget.props
*.nuget.targets

# Microsoft Azure 生成输出
csx/
*.build.csdef

# Microsoft Azure 模拟器
ecf/
rcf/

# Windows Store 应用包目录与文件
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Visual Studio 缓存文件
# 以 .cache 结尾的文件可忽略
*.[Cc]ache
# 但保留以 .cache 结尾的目录
!?*.[Cc]ache/

# 其他
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# 包含强名称文件会带来安全风险
# (https://github.com/github/gitignore/pull/2483#issue-259490424)
#*.snk

# 由于存在多种工作流，如需忽略 bower_components，请取消注释下一行
# (https://github.com/github/gitignore/pull/1529#issuecomment-104372622)
#bower_components/

# RIA/Silverlight 项目
Generated_Code/

# 将旧项目文件转换为较新 Visual Studio 版本时的备份与报告文件。
# 备份文件并不需要，
# 因为我们有 git ;-)
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server 文件
*.mdf
*.ldf
*.ndf

# Business Intelligence 项目
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# GhostDoc 插件设置文件
*.GhostDoc.xml

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/

# Visual Studio 6 生成日志
*.plg

# Visual Studio 6 工作区选项文件
*.opt

# Visual Studio 6 自动生成的工作区文件（记录打开了哪些文件等）
*.vbw

# Visual Studio 6 工作区与项目文件（包含要包含到项目中的文件）
*.dsw
*.dsp

# Visual Studio 6 技术文件
*.ncb
*.aps

