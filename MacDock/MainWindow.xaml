﻿<Window x:Class="MacDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="DockShell"
                CornerRadius="16"
                Background="#C226262E"
                BorderThickness="0"
                Padding="10,10"
                HorizontalAlignment="Stretch"
                ClipToBounds="False"
                AllowDrop="True"
                DragEnter="OnDockDragEnter"
                DragOver="OnDockDragOver"
                DragLeave="OnDockDragLeave"
                Drop="OnDockDrop">
            <Border.ContextMenu>
                <ContextMenu Opened="OnDockMenuOpened">
                    <MenuItem Header="设置..." Click="OnDockMenuSettings"/>
                    <MenuItem Header="添加文件..." Click="OnDockMenuAddItem"/>
                    <MenuItem Header="添加文件夹（内置）..." Click="OnDockMenuAddFolder"/>
                    <MenuItem Header="显示 / 隐藏桌面图标 (F2)" Click="OnDockMenuToggleDesktop"/>
                    <Separator/>
                    <MenuItem Header="退出 MacDock" Click="OnDockMenuExit"/>
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel x:Name="ItemsHost" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>


