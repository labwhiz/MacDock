<Window x:Class="MacDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:MacDock.Services"
        Title="MacDock 设置"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Background="#FFF4F4F6">
    <Window.Resources>
        <svc:DockItemIconConverter x:Key="DockItemIconConverter"/>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <TabControl DockPanel.Dock="Top" x:Name="Tabs">
            <!-- ============ 常规 ============ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="图标尺寸" FontWeight="SemiBold"/>
                        <Slider x:Name="SldIconSize" Minimum="32" Maximum="96" TickFrequency="4" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblIconSize" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="放大强度（仅放大鼠标悬停的图标）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldBoost" Minimum="0.2" Maximum="2.0" TickFrequency="0.1"/>
                        <TextBlock x:Name="LblBoost" Foreground="#FF666666" Margin="0,0,0,2"/>
                        <TextBlock Text="放大时背景栏保持不动，图标向背景外侧生长" Foreground="#FF888888" FontSize="11" Margin="0,0,0,10"/>

                        <TextBlock Text="背景宽度（0 = 自动贴合，像素）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldMinW" Minimum="0" Maximum="2000" TickFrequency="20" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblMinW" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="背景高度（0 = 自动贴合，像素）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldMinH" Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblMinH" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="图标间距" FontWeight="SemiBold"/>
                        <Slider x:Name="SldSpacing" Minimum="2" Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblSpacing" Foreground="#FF666666" Margin="0,0,0,12"/>

                        <TextBlock Text="Dock 位置" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbPosition" Margin="0,4,0,10"/>

                        <TextBlock Text="距屏幕边缘距离（像素）" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <Slider x:Name="SldOffsetY" Minimum="0" Maximum="240" TickFrequency="4" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblOffsetY" Foreground="#FF666666" Margin="0,0,0,8"/>

                        <TextBlock Text="水平偏移（像素，负值向左）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldOffsetX" Minimum="-240" Maximum="240" TickFrequency="4" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblOffsetX" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="背景框圆角（像素，0 为直角）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldCorner" Minimum="0" Maximum="32" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblCorner" Foreground="#FF666666" Margin="0,0,0,8"/>

                        <TextBlock Text="边缘唤出距离（像素，鼠标距屏幕边缘多近时唤出）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldHotzone" Minimum="4" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblHotzone" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="文件夹面板与图标间距（像素）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldFolderGap" Minimum="0" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="LblFolderGap" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="背景样式" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbBgStyle" Margin="0,4,0,12"/>

                        <TextBlock Text="背景颜色" FontWeight="SemiBold"/>
                        <WrapPanel x:Name="ColorSwatches" Margin="0,6,0,6"/>
                        <TextBlock x:Name="LblBgColor" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <TextBlock Text="背景不透明度（毛玻璃 / 透明样式）" FontWeight="SemiBold"/>
                        <Slider x:Name="SldBgOpacity" Minimum="0.1" Maximum="1.0" TickFrequency="0.05"/>
                        <TextBlock x:Name="LblBgOpacity" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkBorder" Content="显示边框" Margin="0,4"/>
                        <TextBlock Text="边框颜色" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <WrapPanel x:Name="BorderColorSwatches" Margin="0,6,0,6"/>
                        <TextBlock x:Name="LblBorderColor" Foreground="#FF666666" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkBlockShow" Content="被窗口覆盖时禁止唤出 Dock（快捷键可开关）" Margin="0,4"/>
                        <CheckBox x:Name="ChkEdgeShow" Content="鼠标移到屏幕边缘时唤出 Dock" Margin="0,4"/>
                        <CheckBox x:Name="ChkStartup" Content="开机自动启动 MacDock" Margin="0,4"/>

                        <Separator Margin="0,14,0,10"/>
                        <TextBlock Text="快捷键（全局）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkHotkey" Content="启用" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbModifier" Width="90" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbHotkeyKey" Width="90" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="隐藏 / 显示桌面图标快捷键" Foreground="#FF888888" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkBlockHotkey" Content="启用" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbBlockModifier" Width="90" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="+" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbBlockKey" Width="90" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="开关「被覆盖时禁止唤出 Dock」快捷键" Foreground="#FF888888" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 图标 ============ -->
            <TabItem Header="图标">
                <DockPanel Margin="10">
                    <GroupBox DockPanel.Dock="Top" Header="添加图标" Margin="0,0,0,10" Padding="6">
                        <StackPanel Margin="6">
                            <TextBlock Text="输入路径（文件 / 快捷方式 / 文件夹）" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="BtnAddPath" Content="添加" Click="OnAddPathClick" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,4"/>
                                <TextBox x:Name="TxtPath" Padding="6,4" VerticalContentAlignment="Center"
                                         ToolTip="例如：D:\Projects 或 D:\setup.exe"/>
                            </DockPanel>
                            <TextBlock Text="或：也可以直接把文件、快捷方式 (.lnk)、文件夹拖到 Dock 栏上添加"
                                       Foreground="#FF888888" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnAdd" Content="添加文件..." Click="OnAddClick"/>
                                <Button x:Name="BtnAddFolder" Content="添加文件夹（内置）..." Click="OnAddFolderClick" Margin="0,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnUp" Content="上移" Click="OnUpClick"/>
                        <Button x:Name="BtnDown" Content="下移" Click="OnDownClick"/>
                        <Button x:Name="BtnRemove" Content="移除选中" Click="OnRemoveClick"/>
                    </StackPanel>
                    <GroupBox DockPanel.Dock="Bottom" Header="内置文件夹图标样式" Margin="0,10,0,0" Padding="6">
                        <StackPanel Margin="6">
                            <TextBlock Text="选中列表中的内置文件夹后，可更换它的图标：" Foreground="#FF666666" FontSize="11" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="PresetIconPanel" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnPickSoftwareIcon" Content="使用软件图标..." Click="OnPickSoftwareIconClick"/>
                                <Button x:Name="BtnUploadIcon" Content="上传图标图片..." Click="OnUploadIconClick"/>
                                <Button x:Name="BtnResetIcon" Content="恢复默认" Click="OnResetIconClick" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="图标列表（选中后可用下方按钮调整顺序或移除）" Padding="4">
                        <ListBox x:Name="ItemList" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ., Converter={StaticResource DockItemIconConverter}}"
                                               Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="（内置文件夹）" Foreground="#FF4A90D9" FontSize="11" Margin="6,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FolderItems}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TargetPath}" Foreground="#FF888888" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </DockPanel>
            </TabItem>        </TabControl>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnDefault" Content="恢复默认" Click="OnDefaultClick"/>
            <Button x:Name="BtnClose" Content="关闭" Click="OnCloseClick" IsDefault="True"/>
        </StackPanel>
    </DockPanel>
</Window>


